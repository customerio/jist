{
  "$schema": "../spec/jist-template-registry-schema.json",
  "basic": [
    {
      "version": "1",
      "root": {
        "type": "layout",
        "direction": "vertical",
        "gap": 6,
        "children": [
          { "type": "heading", "name": "title" },
          { "type": "text", "name": "body" },
          { "type": "date", "name": "timestamp" }
        ]
      }
    }
  ],
  "image": [
    {
      "version": "1",
      "root": {
        "type": "layout",
        "direction": "vertical",
        "gap": 8,
        "children": [
          { "type": "heading", "name": "title" },
          {
            "type": "layout",
            "direction": "vertical",
            "margin": { "top": 4, "bottom": 4 },
            "children": [
              {
                "type": "image",
                "name": "media",
                "width": "fill",
                "height": 180,
                "objectFit": "cover",
                "borderRadius": 8
              }
            ]
          },
          { "type": "text", "name": "body" },
          { "type": "date", "name": "timestamp" }
        ]
      }
    }
  ],
  "cta": [
    {
      "version": "1",
      "root": {
        "type": "layout",
        "direction": "vertical",
        "gap": 6,
        "children": [
          { "type": "heading", "name": "title" },
          { "type": "text", "name": "body" },
          {
            "type": "layout",
            "direction": "horizontal",
            "align": "center",
            "justify": "space-between",
            "margin": { "top": 4 },
            "children": [
              { "type": "date", "name": "timestamp" },
              { "type": "button", "name": "cta", "variant": "secondary" }
            ]
          }
        ]
      }
    }
  ],
  "liveActivity": [
    {
      "version": "1",
      "root": {
        "type": "layout",
        "direction": "vertical",
        "gap": 6,
        "margin": { "top": 4, "right": 8, "bottom": 8, "left": 8 },
        "children": [
          {
            "type": "layout",
            "direction": "horizontal",
            "align": "center",
            "justify": "space-between",
            "children": [
              { "type": "heading", "name": "title", "variant": "h4" },
              { "type": "text", "name": "step", "variant": "caption" }
            ]
          },
          { "type": "text", "name": "body" },
          {
            "type": "layout",
            "direction": "horizontal",
            "align": "center",
            "justify": "space-between",
            "margin": { "top": 4 },
            "children": [
              { "type": "date", "name": "timestamp" },
              { "type": "text", "name": "eta" }
            ]
          }
        ]
      }
    }
  ],
  "action": [
    {
      "version": "1",
      "root": {
        "type": "layout",
        "direction": "vertical",
        "children": [
          {
            "type": "action",
            "name": "action",
            "children": [
              {
                "type": "layout",
                "direction": "horizontal",
                "gap": 10,
                "align": "center",
                "children": [
                  {
                    "type": "image",
                    "name": "avatar",
                    "width": 36,
                    "height": 36,
                    "objectFit": "cover",
                    "borderRadius": 18
                  },
                  {
                    "type": "layout",
                    "direction": "vertical",
                    "gap": 2,
                    "children": [
                      { "type": "heading", "name": "heading", "variant": "h4" },
                      { "type": "text", "name": "body" }
                    ]
                  },
                  { "type": "date", "name": "time" }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "hero": [
    {
      "version": "1",
      "root": {
        "type": "layout",
        "direction": "vertical",
        "gap": 10,
        "children": [
          {
            "type": "image",
            "name": "media",
            "width": "fill",
            "height": 200,
            "objectFit": "cover",
            "borderRadius": 8
          },
          {
            "type": "layout",
            "direction": "horizontal",
            "gap": 12,
            "align": "center",
            "children": [
              {
                "type": "image",
                "name": "avatar",
                "width": 40,
                "height": 40,
                "objectFit": "cover",
                "borderRadius": 20
              },
              {
                "type": "layout",
                "direction": "vertical",
                "gap": 2,
                "children": [
                  { "type": "heading", "name": "title", "variant": "h4" },
                  { "type": "date", "name": "timestamp" }
                ]
              }
            ]
          },
          { "type": "text", "name": "body" },
          {
            "type": "layout",
            "direction": "horizontal",
            "gap": 8,
            "justify": "end",
            "children": [
              { "type": "button", "name": "dismiss", "variant": "secondary" },
              { "type": "button", "name": "cta" }
            ]
          }
        ]
      }
    }
  ],
  "inbox": [
    {
      "version": "1",
      "root": {
        "type": "layout",
        "direction": "vertical",
        "gap": 12,
        "children": [
          { "type": "heading", "name": "title", "variant": "h2" },
          {
            "type": "dynamicLayout",
            "name": "items",
            "direction": "vertical",
            "gap": 12,
            "template": { "type": "template", "name": "action" }
          }
        ]
      }
    }
  ],
  "profile": [
    {
      "version": "1",
      "root": {
        "type": "layout",
        "direction": "vertical",
        "gap": 8,
        "align": "center",
        "children": [
          {
            "type": "image",
            "name": "avatar",
            "width": 72,
            "height": 72,
            "objectFit": "cover",
            "borderRadius": 36
          },
          { "type": "heading", "name": "title", "variant": "h2" },
          { "type": "text", "name": "body" },
          { "type": "date", "name": "timestamp" },
          {
            "type": "layout",
            "direction": "horizontal",
            "gap": 8,
            "margin": { "top": 4 },
            "children": [
              { "type": "button", "name": "secondary", "variant": "secondary" },
              { "type": "button", "name": "cta" }
            ]
          }
        ]
      }
    }
  ],
  "stats": [
    {
      "version": "1",
      "root": {
        "type": "layout",
        "direction": "vertical",
        "gap": 10,
        "children": [
          { "type": "heading", "name": "title" },
          { "type": "text", "name": "body" },
          {
            "type": "layout",
            "direction": "horizontal",
            "justify": "space-evenly",
            "margin": { "top": 4, "bottom": 4 },
            "children": [
              {
                "type": "layout",
                "direction": "vertical",
                "align": "center",
                "gap": 2,
                "children": [
                  { "type": "heading", "name": "value1", "variant": "h2" },
                  { "type": "text", "name": "unit1" }
                ]
              },
              {
                "type": "layout",
                "direction": "vertical",
                "align": "center",
                "gap": 2,
                "children": [
                  { "type": "heading", "name": "value2", "variant": "h2" },
                  { "type": "text", "name": "unit2" }
                ]
              },
              {
                "type": "layout",
                "direction": "vertical",
                "align": "center",
                "gap": 2,
                "children": [
                  { "type": "heading", "name": "value3", "variant": "h2" },
                  { "type": "text", "name": "unit3" }
                ]
              }
            ]
          },
          {
            "type": "layout",
            "direction": "horizontal",
            "gap": 8,
            "align": "center",
            "justify": "end",
            "children": [
              { "type": "date", "name": "timestamp" },
              { "type": "button", "name": "cta", "variant": "secondary" }
            ]
          }
        ]
      }
    }
  ],
  "card": [
    {
      "version": "1",
      "root": {
        "type": "action",
        "name": "action",
        "children": [
          {
            "type": "layout",
            "direction": "horizontal",
            "gap": 10,
            "align": "center",
            "children": [
              {
                "type": "image",
                "name": "icon",
                "width": 40,
                "height": 40,
                "objectFit": "cover",
                "borderRadius": 8
              },
              {
                "type": "layout",
                "direction": "vertical",
                "gap": 2,
                "children": [
                  { "type": "heading", "name": "title", "variant": "h4" },
                  { "type": "text", "name": "body" }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "announcement": [
    {
      "version": "1",
      "root": {
        "type": "layout",
        "direction": "vertical",
        "gap": 10,
        "children": [
          { "type": "heading", "name": "title", "variant": "h2" },
          { "type": "text", "name": "subtitle" },
          {
            "type": "image",
            "name": "media",
            "width": "fill",
            "height": 160,
            "objectFit": "cover",
            "borderRadius": 8
          },
          { "type": "text", "name": "body" },
          {
            "type": "layout",
            "direction": "horizontal",
            "align": "center",
            "justify": "space-between",
            "children": [
              { "type": "date", "name": "timestamp" },
              {
                "type": "layout",
                "direction": "horizontal",
                "gap": 8,
                "children": [
                  { "type": "button", "name": "learn", "variant": "secondary" },
                  { "type": "button", "name": "cta" }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
