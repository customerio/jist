{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jist Theme",
  "description": "Defines visual appearance for Jist template components. The theme is separate from the template — templates define structure, themes define how components look. All numeric measurements are unitless (px on web, pt on iOS, dp on Android). Colors are hex strings (#RRGGBB or #RRGGBBAA).",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "heading": {
      "x-jist-tag": 1,
      "$ref": "#/definitions/headingConfig",
      "description": "Styles for heading components. Supports h2, h3, h4 variant overrides."
    },
    "text": {
      "x-jist-tag": 2,
      "$ref": "#/definitions/textComponentConfig",
      "description": "Styles for text components. Supports arbitrary named variant overrides."
    },
    "date": {
      "x-jist-tag": 3,
      "$ref": "#/definitions/textComponentConfig",
      "description": "Styles for date components. Supports arbitrary named variant overrides."
    },
    "button": {
      "x-jist-tag": 4,
      "$ref": "#/definitions/buttonConfig",
      "description": "Styles for button components. Supports arbitrary named variant overrides (e.g., 'primary', 'secondary')."
    },
    "image": {
      "x-jist-tag": 5,
      "$ref": "#/definitions/imageConfig",
      "description": "Styles for image components. Supports arbitrary named variant overrides."
    },
    "modes": {
      "x-jist-tag": 6,
      "$ref": "#/definitions/colorModes",
      "description": "Color mode overrides. Currently supports 'dark'. Only define the values that change — everything else inherits from the base (light) theme."
    }
  },
  "additionalProperties": false,

  "definitions": {

    "hexColor": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "description": "Hex color string: #RRGGBB or #RRGGBBAA"
    },

    "textStyle": {
      "type": "object",
      "description": "Text styling properties shared by all text-bearing components.",
      "properties": {
        "fontSize": {
          "x-jist-tag": 1,
          "type": "number",
          "minimum": 0,
          "description": "Font size (unitless — px/pt/sp)."
        },
        "fontWeight": {
          "x-jist-tag": 2,
          "type": "number",
          "minimum": 100,
          "maximum": 900,
          "multipleOf": 100,
          "description": "Font weight (100–900). 400 = normal, 700 = bold."
        },
        "fontFamily": {
          "x-jist-tag": 3,
          "type": "string",
          "description": "Font family name. Platform resolves to the nearest available font."
        },
        "color": {
          "x-jist-tag": 4,
          "$ref": "#/definitions/hexColor",
          "description": "Text color."
        },
        "lineHeight": {
          "x-jist-tag": 5,
          "type": "number",
          "minimum": 0,
          "description": "Line height as a unitless multiplier (e.g., 1.5 = 150% of font size)."
        },
        "letterSpacing": {
          "x-jist-tag": 6,
          "type": "number",
          "description": "Letter spacing (unitless — px/pt/sp)."
        },
        "maxLines": {
          "x-jist-tag": 7,
          "type": "integer",
          "minimum": 1,
          "description": "Maximum visible lines. Text beyond this is clamped with an ellipsis."
        }
      },
      "additionalProperties": false
    },

    "backgroundStyle": {
      "type": "object",
      "description": "Background styling.",
      "properties": {
        "color": {
          "x-jist-tag": 1,
          "$ref": "#/definitions/hexColor",
          "description": "Background color."
        }
      },
      "additionalProperties": false
    },

    "borderStyle": {
      "type": "object",
      "description": "Border styling.",
      "properties": {
        "width": {
          "x-jist-tag": 1,
          "type": "number",
          "minimum": 0,
          "description": "Border width (unitless — px/pt/dp)."
        },
        "color": {
          "x-jist-tag": 2,
          "$ref": "#/definitions/hexColor",
          "description": "Border color."
        },
        "radius": {
          "x-jist-tag": 3,
          "type": "number",
          "minimum": 0,
          "description": "Corner radius (unitless — px/pt/dp)."
        }
      },
      "additionalProperties": false
    },

    "shadowStyle": {
      "type": "object",
      "description": "Shadow styling.",
      "properties": {
        "color": {
          "x-jist-tag": 1,
          "$ref": "#/definitions/hexColor",
          "description": "Shadow color (use alpha for transparency, e.g., #00000033)."
        },
        "offsetX": {
          "x-jist-tag": 2,
          "type": "number",
          "description": "Horizontal shadow offset (unitless — px/pt/dp)."
        },
        "offsetY": {
          "x-jist-tag": 3,
          "type": "number",
          "description": "Vertical shadow offset (unitless — px/pt/dp)."
        },
        "blur": {
          "x-jist-tag": 4,
          "type": "number",
          "minimum": 0,
          "description": "Shadow blur radius (unitless — px/pt/dp)."
        }
      },
      "additionalProperties": false
    },

    "spacingBox": {
      "type": "object",
      "description": "Spacing values for padding or margin. All values are unitless (px/pt/dp).",
      "properties": {
        "top":    { "x-jist-tag": 1, "type": "number", "description": "Top spacing." },
        "right":  { "x-jist-tag": 2, "type": "number", "description": "Right spacing." },
        "bottom": { "x-jist-tag": 3, "type": "number", "description": "Bottom spacing." },
        "left":   { "x-jist-tag": 4, "type": "number", "description": "Left spacing." }
      },
      "additionalProperties": false
    },

    "buttonStates": {
      "type": "object",
      "description": "Interaction state overrides for buttons. Each state can override any base button style property. Unset properties fall back to the base style.",
      "properties": {
        "hover":    { "x-jist-tag": 1, "$ref": "#/definitions/buttonStateStyle" },
        "active":   { "x-jist-tag": 2, "$ref": "#/definitions/buttonStateStyle" },
        "disabled": { "x-jist-tag": 3, "$ref": "#/definitions/buttonStateStyle" }
      },
      "additionalProperties": false
    },

    "buttonStateStyle": {
      "type": "object",
      "description": "Style overrides for a specific interaction state.",
      "properties": {
        "text":       { "x-jist-tag": 1, "$ref": "#/definitions/textStyle" },
        "background": { "x-jist-tag": 2, "$ref": "#/definitions/backgroundStyle" },
        "border":     { "x-jist-tag": 3, "$ref": "#/definitions/borderStyle" },
        "shadow":     { "x-jist-tag": 4, "$ref": "#/definitions/shadowStyle" }
      },
      "additionalProperties": false
    },

    "textComponentVariant": {
      "type": "object",
      "description": "Variant override for a text-bearing component (heading, text, date). Only define the properties that should differ from the base.",
      "properties": {
        "text":    { "x-jist-tag": 1, "$ref": "#/definitions/textStyle" },
        "padding": { "x-jist-tag": 2, "$ref": "#/definitions/spacingBox" },
        "margin":  { "x-jist-tag": 3, "$ref": "#/definitions/spacingBox" }
      },
      "additionalProperties": false
    },

    "buttonVariant": {
      "type": "object",
      "description": "Variant override for a button component. Only define the properties that should differ from the base.",
      "properties": {
        "text":       { "x-jist-tag": 1, "$ref": "#/definitions/textStyle" },
        "background": { "x-jist-tag": 2, "$ref": "#/definitions/backgroundStyle" },
        "border":     { "x-jist-tag": 3, "$ref": "#/definitions/borderStyle" },
        "shadow":     { "x-jist-tag": 4, "$ref": "#/definitions/shadowStyle" },
        "padding":    { "x-jist-tag": 5, "$ref": "#/definitions/spacingBox" },
        "margin":     { "x-jist-tag": 6, "$ref": "#/definitions/spacingBox" },
        "minWidth":   { "x-jist-tag": 7, "type": "number", "minimum": 0 },
        "minHeight":  { "x-jist-tag": 8, "type": "number", "minimum": 0 },
        "states":     { "x-jist-tag": 9, "$ref": "#/definitions/buttonStates" }
      },
      "additionalProperties": false
    },

    "imageVariant": {
      "type": "object",
      "description": "Variant override for an image component.",
      "properties": {
        "border":  { "x-jist-tag": 1, "$ref": "#/definitions/borderStyle" },
        "padding": { "x-jist-tag": 2, "$ref": "#/definitions/spacingBox" },
        "margin":  { "x-jist-tag": 3, "$ref": "#/definitions/spacingBox" }
      },
      "additionalProperties": false
    },

    "headingConfig": {
      "type": "object",
      "description": "Heading component styles. Base properties apply to all headings. Variant sub-objects (h2, h3, h4) override specific properties.",
      "properties": {
        "text":    { "x-jist-tag": 1, "$ref": "#/definitions/textStyle" },
        "padding": { "x-jist-tag": 2, "$ref": "#/definitions/spacingBox" },
        "margin":  { "x-jist-tag": 3, "$ref": "#/definitions/spacingBox" },
        "h2": {
          "x-jist-tag": 4,
          "$ref": "#/definitions/textComponentVariant",
          "description": "Style overrides for h2 headings."
        },
        "h3": {
          "x-jist-tag": 5,
          "$ref": "#/definitions/textComponentVariant",
          "description": "Style overrides for h3 headings."
        },
        "h4": {
          "x-jist-tag": 6,
          "$ref": "#/definitions/textComponentVariant",
          "description": "Style overrides for h4 headings."
        }
      },
      "additionalProperties": false
    },

    "textComponentConfig": {
      "type": "object",
      "description": "Text/date component styles. Base properties apply to all instances. Additional keys are treated as named variant overrides.",
      "properties": {
        "text":    { "x-jist-tag": 1, "$ref": "#/definitions/textStyle" },
        "padding": { "x-jist-tag": 2, "$ref": "#/definitions/spacingBox" },
        "margin":  { "x-jist-tag": 3, "$ref": "#/definitions/spacingBox" }
      },
      "additionalProperties": {
        "$ref": "#/definitions/textComponentVariant"
      }
    },

    "buttonConfig": {
      "type": "object",
      "description": "Button component styles. Base properties apply to all buttons. Additional keys are treated as named variant overrides (e.g., 'primary', 'secondary').",
      "properties": {
        "text":       { "x-jist-tag": 1, "$ref": "#/definitions/textStyle" },
        "background": { "x-jist-tag": 2, "$ref": "#/definitions/backgroundStyle" },
        "border":     { "x-jist-tag": 3, "$ref": "#/definitions/borderStyle" },
        "shadow":     { "x-jist-tag": 4, "$ref": "#/definitions/shadowStyle" },
        "padding":    { "x-jist-tag": 5, "$ref": "#/definitions/spacingBox" },
        "margin":     { "x-jist-tag": 6, "$ref": "#/definitions/spacingBox" },
        "minWidth": {
          "x-jist-tag": 7,
          "type": "number",
          "minimum": 0,
          "description": "Minimum button width."
        },
        "minHeight": {
          "x-jist-tag": 8,
          "type": "number",
          "minimum": 0,
          "description": "Minimum button height."
        },
        "states": { "x-jist-tag": 9, "$ref": "#/definitions/buttonStates" }
      },
      "additionalProperties": {
        "$ref": "#/definitions/buttonVariant"
      }
    },

    "imageConfig": {
      "type": "object",
      "description": "Image component styles. Note: sizing/scaling properties (width, height, objectFit) are defined on the template node, not in the theme.",
      "properties": {
        "border":  { "x-jist-tag": 1, "$ref": "#/definitions/borderStyle" },
        "padding": { "x-jist-tag": 2, "$ref": "#/definitions/spacingBox" },
        "margin":  { "x-jist-tag": 3, "$ref": "#/definitions/spacingBox" }
      },
      "additionalProperties": {
        "$ref": "#/definitions/imageVariant"
      }
    },

    "colorModes": {
      "type": "object",
      "description": "Color mode overrides. Each mode is a sparse override — only define the values that change. Properties not defined in a mode inherit from the base (light) theme.",
      "properties": {
        "dark": {
          "x-jist-tag": 1,
          "type": "object",
          "description": "Dark mode overrides. Same structure as the top-level theme, but only include properties that change (typically colors).",
          "properties": {
            "heading": { "x-jist-tag": 1, "$ref": "#/definitions/headingConfig" },
            "text":    { "x-jist-tag": 2, "$ref": "#/definitions/textComponentConfig" },
            "date":    { "x-jist-tag": 3, "$ref": "#/definitions/textComponentConfig" },
            "button":  { "x-jist-tag": 4, "$ref": "#/definitions/buttonConfig" },
            "image":   { "x-jist-tag": 5, "$ref": "#/definitions/imageConfig" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
